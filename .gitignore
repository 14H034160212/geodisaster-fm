# =============================================================================
# Exclude heavy raw/processed data, keep small reproducible artefacts.
# =============================================================================

# Raw geospatial downloads (Sen1Floods11 ~1.7 GB, GEE exports ~GB)
data/raw/
data/interim/
data/external/
data/cache/

# Per-event patch tensors (~34 GB of .npy files)
data/processed/patches/

# Allow small reproducible config-shaped artefacts under data/processed
!data/processed/
data/processed/*
!data/processed/norm_stats_*.yaml

# =============================================================================
# Outputs: exclude heavy run state, keep small results + figures + report
# =============================================================================
outputs/**

# Re-include figures, top-level result JSONs, sweep CSVs, the deployable site
!outputs/
!outputs/figures/
!outputs/figures/**
!outputs/site/
!outputs/site/**
!outputs/sen1floods11_*.json
!outputs/four_way_results_table.json
!outputs/reproducibility.json
!outputs/few_shot_unet_s1s2/
!outputs/few_shot_unet_s1s2/few_shot_results.csv
!outputs/few_shot_unet_s1s2/few_shot_summary.json
!outputs/few_shot_ae_s1/
!outputs/few_shot_ae_s1/few_shot_results.csv
!outputs/few_shot_ae_s1/few_shot_summary.json

# Always exclude checkpoints, lightning logs, tmp run dirs
**/checkpoints/
**/lightning_logs/
**/run.log
**/wandb/
**/mlruns/
runs/

# Geospatial intermediate rasters (large)
*.tif
*.tiff
*.cog
*.zarr
*.nc

# Vector formats can be moderate — exclude by default
*.shp
*.shx
*.dbf
*.prj
*.cpg

# =============================================================================
# Python / IDE / system
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
notebooks/scratch/
.idea/
.vscode/
*.swp
*.swo

# =============================================================================
# Secrets — NEVER commit these
# =============================================================================
.env
.envrc
secrets/
*.pem
*.key
gcp-key.json
ee-credentials.json

# Claude Code session settings
.claude/

# Whitelist orchestrator outputs (added 2026-05-26)
!outputs/leave_one_region_out/
!outputs/leave_one_region_out/**
!outputs/leave_one_region_out_multiseed/
!outputs/leave_one_region_out_multiseed/**
!outputs/zero_shot/
!outputs/zero_shot/**
!outputs/few_shot_ae_stack/
!outputs/few_shot_ae_stack/few_shot_results.csv
!outputs/few_shot_ae_stack/few_shot_summary.json
!outputs/few_shot_ae_stack/few_shot_multiseed_summary.json
!outputs/few_shot_ae_stack_seed*/
!outputs/few_shot_ae_stack_seed*/few_shot_results.csv
!outputs/few_shot_ae_stack_seed*/few_shot_summary.json
!outputs/sen1floods11_deeplab_s1s2/
!outputs/sen1floods11_deeplab_s1s2/run.log
!outputs/dispatch/
!outputs/dispatch/**

# Re-exclude checkpoints / logs inside whitelisted leave-one-out dirs
outputs/leave_one_region_out/**/checkpoints/
outputs/leave_one_region_out/**/lightning_logs/
outputs/leave_one_region_out/**/*.ckpt
outputs/leave_one_region_out_multiseed/**/checkpoints/
outputs/leave_one_region_out_multiseed/**/lightning_logs/
outputs/leave_one_region_out_multiseed/**/*.ckpt
outputs/few_shot_ae_stack_seed*/**/checkpoints/
outputs/few_shot_ae_stack_seed*/**/lightning_logs/
outputs/few_shot_ae_stack_seed*/**/*.ckpt

# Layer 3 active-adaptation results (small JSON only)
!outputs/active_adapt/
!outputs/active_adapt/*.json
!outputs/active_adapt/summary_all_regions.json

# Layer 3 PPO policy results (small JSON only)
!outputs/layer3_ppo/
!outputs/layer3_ppo/*.json
